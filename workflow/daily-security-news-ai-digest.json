{
  "name": "Daily Security News AI Digest",
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "a1",
      "name": "Every Morning 8 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      }
    },
    {
      "id": "a2",
      "name": "Fetch Security News (RSS)",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "https://feeds.feedburner.com/TheHackersNews",
        "options": {}
      }
    },
    {
      "id": "a3",
      "name": "Keep Latest 5",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "maxItems": 5
      }
    },
    {
      "id": "a4",
      "name": "Combine Articles",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "title"
            },
            {
              "fieldToAggregate": "contentSnippet"
            },
            {
              "fieldToAggregate": "link"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a5",
      "name": "AI Summarizer",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        880,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are a security analyst. Summarize these {{ $json.title.length }} cybersecurity news articles into a short morning brief.\nFor each article give: a one-line headline, a 2-sentence summary, and a risk level (Low / Medium / High).\nEnd with one line: \"Top action for today\".\n\nTitles: {{ JSON.stringify($json.title) }}\nSnippets: {{ JSON.stringify($json.contentSnippet) }}\nLinks: {{ JSON.stringify($json.link) }}"
      }
    },
    {
      "id": "a6",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        880,
        220
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "a7",
      "name": "Email Me the Brief",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1180,
        0
      ],
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "=Security Brief {{ $now.toFormat('dd LLL yyyy') }}",
        "emailType": "text",
        "message": "={{ $json.text }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every Morning 8 AM": {
      "main": [
        [
          {
            "node": "Fetch Security News (RSS)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Security News (RSS)": {
      "main": [
        [
          {
            "node": "Keep Latest 5",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep Latest 5": {
      "main": [
        [
          {
            "node": "Combine Articles",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Combine Articles": {
      "main": [
        [
          {
            "node": "AI Summarizer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Summarizer",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Summarizer": {
      "main": [
        [
          {
            "node": "Email Me the Brief",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}